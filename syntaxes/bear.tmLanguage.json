{
  "name": "Bear",
  "scopeName": "source.bear",
  "fileTypes": ["bear"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#char" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#builtin" },
    { "include": "#arrow-delimiter" },
    { "include": "#operator" },
    { "include": "#delimiter" },
    { "include": "#function-call" },
    { "include": "#turbofish" },
    { "include": "#constant-case" },
    { "include": "#pascal-type" },
    { "include": "#identifier" }
  ],
  "repository": {

    "comment": {
      "comment": "Line comments only - // to end of line",
      "name": "comment.line.double-slash.bear",
      "match": "\\/\\/.*$",
      "captures": {
        "0": {
          "patterns": [
            {
              "match": "\\b(TODO|FIXME|XXX|NOTE)\\b",
              "name": "keyword.other.todo.bear"
            }
          ]
        }
      }
    },

    "string": {
      "comment": "Double-quoted string literal",
      "name": "string.quoted.double.bear",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.bear" }
      ]
    },

    "char": {
      "comment": "Single-quoted char literal - bearChar (linked to Character, distinct from String)",
      "name": "constant.character.bear",
      "match": "'([^'\\\\]|\\\\.)'"
    },

    "number": {
      "patterns": [
        {
          "comment": "Hex integer",
          "name": "constant.numeric.hex.bear",
          "match": "\\b0x[0-9A-Fa-f]+\\b"
        },
        {
          "comment": "Float",
          "name": "constant.numeric.float.bear",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "comment": "Decimal integer",
          "name": "constant.numeric.integer.bear",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "keyword": {
      "patterns": [
        {
          "comment": "Include / imports - bearInclude",
          "name": "keyword.control.import.bear",
          "match": "\\b(import)\\b"
        },
        {
          "comment": "Storage class / mutability / visibility - bearStorageClass (var is NOT here; it's bearSpecial)",
          "name": "storage.modifier.bear",
          "match": "\\b(mut|static|extern|compt|hid|pub)\\b"
        },
        {
          "comment": "bearSpecial keyword",
          "name": "keyword.other.special.bear",
          "match": "\\b(var)\\b"
        },
        {
          "comment": "Type-defining structure keywords - bearStructure",
          "name": "storage.type.bear",
          "match": "\\b(variant|struct|contract|union|deftype)\\b"
        },
        {
          "comment": "Control flow - bearStatement",
          "name": "keyword.control.flow.bear",
          "match": "\\b(return|yield|break|continue)\\b"
        },
        {
          "comment": "Conditionals - bearConditional",
          "name": "keyword.control.conditional.bear",
          "match": "\\b(if|else|match)\\b"
        },
        {
          "comment": "Loops - bearRepeat",
          "name": "keyword.control.loop.bear",
          "match": "\\b(while|for|in)\\b"
        },
        {
          "comment": "bearMacro - only alignas",
          "name": "keyword.other.macro.bear",
          "match": "\\b(alignas)\\b"
        },
        {
          "comment": "Boolean and null literals - bearBoolean",
          "name": "constant.language.bear",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "comment": "Primitive types - bearType",
          "name": "storage.type.primitive.bear",
          "match": "\\b(i8|u8|i16|u16|i32|u32|i64|u64|usize|isize|char|f32|f64|str|bool|void)\\b"
        },
        {
          "comment": "Remaining keywords - bearKeyword (includes typeof and decay, which are highlighted as keywords in the vim source)",
          "name": "keyword.other.bear",
          "match": "\\b(mod|use|fn|mt|dt|requires|has|is|move|as|self|Self|typeof|decay)\\b"
        }
      ]
    },

    "builtin": {
      "comment": "Compiler builtins/intrinsics prefixed with @ - bearSpecial",
      "name": "keyword.other.special.bear",
      "match": "@(?:same_type|type_to_str|has_contract|static_assert|defined|inferable_as|err|warn|note|help|alignof|sizeof|members_of|statics_of|id|type_id|scoped_id)\\b"
    },

    "operator": {
      "comment": "Operators - special arrows first, then longest to shortest to avoid partial matches",
      "patterns": [
        {
          "comment": "=> is more syntactically significant - bearSpecial",
          "name": "keyword.other.special.bear",
          "match": "=>"
        },
        { "name": "keyword.operator.bear", "match": ">>>=" },
        { "name": "keyword.operator.bear", "match": "(<<=|>>=|>>>|\\.\\.\\.=)" },
        { "name": "keyword.operator.bear", "match": "(\\+\\+|--|\\.\\.\\.)" },
        { "name": "keyword.operator.bear", "match": "(\\.\\.|<<|>>|>=|<=|==|!=|\\+=|-=|\\*=|/=|%=|&=|\\^=|\\|\\||&&)" },
        { "name": "keyword.operator.bear", "match": "[+\\-*/%=&|!<>^~]" }
      ]
    },

    "arrow-delimiter": {
      "comment": "-> and :: are delimiters (bearDelimiter), not operators. Included before #operator so - and : don't match first.",
      "name": "punctuation.delimiter.bear",
      "match": "->|::|~>"
    },

    "delimiter": {
      "comment": "Punctuation and delimiters - bearDelimiter (brackets and punctuation share one highlight group in the vim source)",
      "name": "punctuation.delimiter.bear",
      "match": "[(){}\\[\\],;:#.]"
    },

    "function-call": {
      "comment": "Any lowercase/underscore identifier immediately before a ( - bearFunction",
      "name": "entity.name.function.bear",
      "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },

    "turbofish": {
      "comment": "Lowercase identifier immediately before :: (foo::<...> / foo::T) - bearFunction",
      "name": "entity.name.function.bear",
      "match": "\\b[a-z_][A-Za-z0-9_]*(?=::)"
    },

    "constant-case": {
      "comment": "ALL_CAPS_IDENTIFIERS - bearConstant. Must come before pascal-type.",
      "name": "constant.other.bear",
      "match": "\\b[A-Z][A-Z0-9_]*\\b"
    },

    "pascal-type": {
      "comment": "PascalCase types - must contain at least one lowercase letter to exclude ALL_CAPS",
      "name": "entity.name.type.bear",
      "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b"
    },

    "identifier": {
      "comment": "Plain lowercase/underscore identifiers - bearIdentifier",
      "name": "variable.other.bear",
      "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
    }

  }
}
